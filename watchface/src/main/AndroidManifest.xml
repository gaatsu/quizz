<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.watch" />

    <!-- hasCode must be false: a Watch Face Format face ships no code. -->
    <application
        android:label="@string/watch_face_name"
        android:hasCode="false">

        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" />

        <!-- Version 4: the TEMP box reads the [WEATHER.*] sources (v2), the
             glow composites additively (v3), and the ambient transition
             eases rather than cuts (v4). Weather needs no permission
             here: the system supplies it. -->
        <property
            android:name="com.google.wear.watchface.format.version"
            android:value="4" />
    </application>
</manifest>
