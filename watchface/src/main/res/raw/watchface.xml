    <PartText x="0" y="378" width="450" height="32" alpha="0">
      <Variant mode="AMBIENT" target="alpha" value="255" duration="0.5" startOffset="0.5" interpolation="EASE_IN"/>
      <Text align="CENTER">
        <Font family="b612_mono" size="18" color="#FF1E7A45">
          <Upper>
            <Template>%s %s %s<Parameter
              expression="[DAY_OF_WEEK_S]"/><Parameter
              expression="[DAY_Z]"/><Parameter
              expression="[MONTH_S]"/></Template>
          </Upper>
        </Font>
      </Text>
    </PartText>


    <!-- ================================================================
         Datalink. Unread notifications show up as an antenna mast putting
         out a signal, under the date, with the count beside it. Green on
         purpose: in a cockpit green is advisory and amber is caution, so
         the amber stays reserved for the PULL UP and nothing competes
         with it. The system draws its own dot on top of all this — a
         watch face cannot remove that one, only the wearer can, in the
         watch's notification settings.
         ================================================================ -->
    <Condition>
      <Expressions>
        <Expression name="hasUnread">[UNREAD_NOTIFICATION_COUNT] &gt; 0</Expression>
      </Expressions>
      <Compare expression="hasUnread">
        <Group name="datalink" x="0" y="0" width="450" height="450" alpha="230">
          <Variant mode="AMBIENT" target="alpha" value="0" duration="0.5" interpolation="EASE_OUT"/>

          <PartDraw x="0" y="0" width="450" height="450">
            <!-- mast, on a short base -->
            <Line startX="216" startY="442" endX="216" endY="428">
              <Stroke color="#FF4DFF8F" thickness="2"/>
            </Line>
            <Line startX="210" startY="442" endX="222" endY="442">
              <Stroke color="#FF4DFF8F" thickness="2"/>
            </Line>
            <!-- two arcs of signal coming off the mast head -->
            <Arc centerX="216" centerY="428" width="22" height="22"
                 startAngle="-46" endAngle="46">
              <Stroke color="#FF4DFF8F" thickness="2" cap="ROUND"/>
            </Arc>
            <Arc centerX="216" centerY="428" width="36" height="36"
                 startAngle="-40" endAngle="40">
              <Stroke color="#FF4DFF8F" thickness="2" cap="ROUND"/>
            </Arc>
          </PartDraw>

          <PartText x="238" y="416" width="50" height="30">
            <Text align="START">
              <Font family="b612_mono" size="20" color="#FF4DFF8F">
                <Template>%d<Parameter expression="[UNREAD_NOTIFICATION_COUNT]"/></Template>
              </Font>
            </Text>
          </PartText>
        </Group>
      </Compare>
    </Condition>

  </Scene>
</WatchFace>
